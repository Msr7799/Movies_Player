{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "rewrites": [
    { "source": "/api", "destination": "/api/router?__api_path=__root" },
    { "source": "/api/openapi", "destination": "/api/router?__api_path=openapi" },
    { "source": "/api/v1/:path*", "destination": "/api/router?__api_path=v1/:path*" },
    { "source": "/api/admin/catalog", "destination": "/api/router?__api_path=admin/catalog" },
    { "source": "/api/admin/settings", "destination": "/api/router?__api_path=admin/settings" }
  ],
  "functions": {
    "api/router.ts": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}

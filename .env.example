# Server-only API keys. Never prefix these with NEXT_PUBLIC_.
TAVILY_API_KEY=
SERPER_API_KEY=
GEMINI_API_KEY=
GEMINI_AUTO_SUGGESTED_API_KEY=

# Optional comma-separated Gemini model fallback lists.
GEMINI_MODELS_LITE=gemini-3.5-flash-lite,gemini-3.8-flash
GEMINI_PREFLIGHT_MODELS=

# Reserved for optional Tavily defaults. The movie discovery route enforces
# advanced search and a legal-source allowlist regardless of this value.
TAVILY_DEFAULT_PARAMETERS=

# Shared public catalog, playback history, and analytics.
MONGODB_URI=
MONGODB_DATABASE=any_movie
# Optional fallback when the host DNS resolver blocks mongodb+srv lookups.
MONGODB_DNS_SERVERS=

# Private owner-only dashboard at /admin. Use a password of at least 12 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional. If empty, changing ADMIN_PASSWORD also invalidates existing sessions.
ADMIN_SESSION_SECRET=
